PORT=8000
# Option 1: Cloud MongoDB Atlas (viewable in MongoDB Compass)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Option 2: Local MongoDB Compass (requires MongoDB Community Server installed locally)
# MONGO_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=put_a_long_random_text_here
# Your deployed frontend URL(s), comma separated, no trailing slash
CLIENT_URL=https://your-frontend.vercel.app
# Used by the seed script to create your admin login
ADMIN_NAME=Ali Hamza
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password
